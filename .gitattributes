# Set default behavior to automatically normalize line endings
* text=auto

# C# source files
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf

# Config files
*.json text eol=crlf
*.xml text eol=crlf
*.config text eol=crlf

# Scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Documentation
*.md text eol=crlf
*.txt text eol=crlf

# Prevent binary files from being modified
*.dll binary
*.exe binary
*.pdb binary
*.db binary
