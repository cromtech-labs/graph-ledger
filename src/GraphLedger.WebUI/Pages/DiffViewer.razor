@page "/diff"
@rendermode InteractiveServer
@inject IDbContextFactory<GraphLedgerDbContext> ContextFactory
@inject IDiffEngine DiffEngine
@inject NavigationManager Navigation

<PageTitle>Diff Viewer - GraphLedger</PageTitle>

<h1>Diff Viewer</h1>

<div class="row mb-4">
    <div class="col-md-4">
        <label for="resourceTypeFilter" class="form-label">1. Select Resource Type</label>
        <select class="form-select" id="resourceTypeFilter" value="@_selectedResourceType" @onchange="OnResourceTypeChanged">
            <option value="">All Types</option>
            @foreach (var type in _resourceTypes)
            {
                <option value="@type">@GetShortTypeName(type)</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label for="resourceFilter" class="form-label">2. Select Resource</label>
        <select class="form-select" id="resourceFilter" value="@_selectedResourceId" @onchange="OnResourceChanged" disabled="@string.IsNullOrEmpty(_selectedResourceType)">
            <option value="">All Resources</option>
            @foreach (var resource in _filteredResources)
            {
                <option value="@resource.Id.ToString()">@TruncateString(resource.DisplayName, 40)</option>
            }
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        @if (!string.IsNullOrEmpty(_selectedResourceId))
        {
            <a href="resources/@_selectedResourceId" class="btn btn-outline-secondary">View History</a>
        }
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-5">
        <label for="leftSnapshot" class="form-label">Left Snapshot (Older)</label>
        <select class="form-select" id="leftSnapshot" value="@_leftSnapshotId" @onchange="OnLeftSnapshotChanged">
            <option value="">Select snapshot...</option>
            @foreach (var snapshot in _filteredSnapshots)
            {
                var statusLabel = snapshot.HasChangesFromPrevious switch
                {
                    true => " [CHANGED]",
                    false => "",
                    null => " [initial]"
                };
                <option value="@snapshot.Id.ToString()">
                    @snapshot.Id.ToString()[..8] - @TruncateString(snapshot.ResourceDisplayName ?? snapshot.Workload, 25) (@snapshot.CreatedAt.ToString("g"))@statusLabel
                </option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end justify-content-center">
        <span class="text-muted h3">vs</span>
    </div>
    <div class="col-md-5">
        <label for="rightSnapshot" class="form-label">Right Snapshot (Newer)</label>
        <select class="form-select" id="rightSnapshot" value="@_rightSnapshotId" @onchange="OnRightSnapshotChanged">
            <option value="">Select snapshot...</option>
            @foreach (var snapshot in _filteredSnapshots)
            {
                var statusLabel = snapshot.HasChangesFromPrevious switch
                {
                    true => " [CHANGED]",
                    false => "",
                    null => " [initial]"
                };
                <option value="@snapshot.Id.ToString()">
                    @snapshot.Id.ToString()[..8] - @TruncateString(snapshot.ResourceDisplayName ?? snapshot.Workload, 25) (@snapshot.CreatedAt.ToString("g"))@statusLabel
                </option>
            }
        </select>
    </div>
</div>

<div class="mb-4">
    <button class="btn btn-primary" @onclick="CompareSnapshots" disabled="@(!CanCompare || _comparing)">
        @if (_comparing)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            <text>Comparing...</text>
        }
        else
        {
            <text>Compare Snapshots</text>
        }
    </button>

    @if (!string.IsNullOrEmpty(_selectedResourceId) && _filteredSnapshots.Count >= 2)
    {
        <button class="btn btn-outline-secondary ms-2" @onclick="CompareLatestToPrevious">
            Compare Latest to Previous
        </button>
    }
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_diffResult != null)
{
    <div class="card mb-4">
        <div class="card-header">
            <strong>Comparison Result</strong>
            @if (_diffResult.HasChanges)
            {
                <span class="badge bg-warning ms-2">@_diffResult.ChangeCount change(s)</span>
            }
            else
            {
                <span class="badge bg-success ms-2">No changes</span>
            }
        </div>
        <div class="card-body">
            @if (!_diffResult.HasChanges)
            {
                <p class="text-success">The two snapshots are identical.</p>
            }
            else
            {
                <DiffViewerComponent Result="_diffResult" />
            }
        </div>
    </div>
}

@code {
    private List<Snapshot> _allSnapshots = new();
    private List<Snapshot> _filteredSnapshots = new();
    private List<string> _resourceTypes = new();
    private List<Resource> _filteredResources = new();
    private string _selectedResourceType = "";
    private string _selectedResourceId = "";
    private string _leftSnapshotId = "";
    private string _rightSnapshotId = "";
    private bool _comparing;
    private DiffResult? _diffResult;
    private string? _errorMessage;

    private bool CanCompare => !string.IsNullOrEmpty(_leftSnapshotId) &&
                               !string.IsNullOrEmpty(_rightSnapshotId) &&
                               _leftSnapshotId != _rightSnapshotId;

    protected override async Task OnInitializedAsync()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();

        // Load all resource types
        _resourceTypes = await context.Snapshots
            .Where(s => s.UtcmResourceType != null)
            .Select(s => s.UtcmResourceType!)
            .Distinct()
            .OrderBy(t => t)
            .ToListAsync();

        // Load all snapshots
        _allSnapshots = await context.Snapshots
            .OrderByDescending(s => s.CreatedAt)
            .Take(200)
            .ToListAsync();

        _filteredSnapshots = _allSnapshots;

        // Check for query parameters
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["left"] != null)
        {
            _leftSnapshotId = query["left"]!;
        }
        if (query["right"] != null)
        {
            _rightSnapshotId = query["right"]!;
        }

        // If we have a left snapshot, try to infer the resource type
        if (!string.IsNullOrEmpty(_leftSnapshotId) && Guid.TryParse(_leftSnapshotId, out var leftGuid))
        {
            var leftSnapshot = _allSnapshots.FirstOrDefault(s => s.Id == leftGuid);
            if (leftSnapshot?.UtcmResourceType != null)
            {
                _selectedResourceType = leftSnapshot.UtcmResourceType;
                await ApplyFilters();
            }
        }
    }

    private async Task OnResourceTypeChanged(ChangeEventArgs e)
    {
        _selectedResourceType = e.Value?.ToString() ?? "";
        _selectedResourceId = "";
        _leftSnapshotId = "";
        _rightSnapshotId = "";
        _diffResult = null;
        _errorMessage = null;
        await ApplyFilters();
    }

    private async Task OnResourceChanged(ChangeEventArgs e)
    {
        _selectedResourceId = e.Value?.ToString() ?? "";
        _leftSnapshotId = "";
        _rightSnapshotId = "";
        _diffResult = null;
        _errorMessage = null;
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();

        // Filter resources by type
        if (!string.IsNullOrEmpty(_selectedResourceType))
        {
            _filteredResources = await context.Resources
                .Where(r => r.ResourceType == _selectedResourceType)
                .OrderBy(r => r.DisplayName)
                .ToListAsync();
        }
        else
        {
            _filteredResources = new();
        }

        // Filter snapshots
        if (!string.IsNullOrEmpty(_selectedResourceId) && Guid.TryParse(_selectedResourceId, out var resourceId))
        {
            _filteredSnapshots = _allSnapshots
                .Where(s => s.ResourceId == resourceId)
                .ToList();
        }
        else if (!string.IsNullOrEmpty(_selectedResourceType))
        {
            _filteredSnapshots = _allSnapshots
                .Where(s => s.UtcmResourceType == _selectedResourceType)
                .ToList();
        }
        else
        {
            _filteredSnapshots = _allSnapshots;
        }
    }

    private void OnLeftSnapshotChanged(ChangeEventArgs e)
    {
        _leftSnapshotId = e.Value?.ToString() ?? "";
        _diffResult = null;
        _errorMessage = null;
    }

    private void OnRightSnapshotChanged(ChangeEventArgs e)
    {
        _rightSnapshotId = e.Value?.ToString() ?? "";
        _diffResult = null;
        _errorMessage = null;
    }

    private void CompareLatestToPrevious()
    {
        if (_filteredSnapshots.Count >= 2)
        {
            _rightSnapshotId = _filteredSnapshots[0].Id.ToString();
            _leftSnapshotId = _filteredSnapshots[1].Id.ToString();
            _ = CompareSnapshots();
        }
    }

    private async Task CompareSnapshots()
    {
        if (!CanCompare) return;

        _comparing = true;
        _diffResult = null;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();

            if (!Guid.TryParse(_leftSnapshotId, out var leftId))
            {
                _errorMessage = $"Invalid left snapshot ID: {_leftSnapshotId}";
                return;
            }
            if (!Guid.TryParse(_rightSnapshotId, out var rightId))
            {
                _errorMessage = $"Invalid right snapshot ID: {_rightSnapshotId}";
                return;
            }

            var leftSnapshot = await context.Snapshots.FindAsync(leftId);
            var rightSnapshot = await context.Snapshots.FindAsync(rightId);

            if (leftSnapshot == null)
            {
                _errorMessage = "Left snapshot not found";
                return;
            }
            if (rightSnapshot == null)
            {
                _errorMessage = "Right snapshot not found";
                return;
            }

            _diffResult = DiffEngine.Compare(leftSnapshot, rightSnapshot);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error comparing snapshots: {ex.Message}";
        }
        finally
        {
            _comparing = false;
            StateHasChanged();
        }
    }

    private static string TruncateString(string value, int maxLength)
    {
        if (string.IsNullOrEmpty(value)) return "-";
        return value.Length <= maxLength ? value : value[..(maxLength - 3)] + "...";
    }

    private static string GetShortTypeName(string resourceType)
    {
        var parts = resourceType.Split('.');
        return parts.Length > 0 ? parts[^1] : resourceType;
    }
}
