@page "/snapshots"
@page "/snapshots/{SnapshotId}"
@rendermode InteractiveServer
@inject IDbContextFactory<GraphLedgerDbContext> ContextFactory

<PageTitle>Snapshots - GraphLedger</PageTitle>

<h1>Snapshots</h1>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_selectedSnapshot != null)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="snapshots">Snapshots</a></li>
            <li class="breadcrumb-item active">@_selectedSnapshot.Id.ToString()[..8]</li>
        </ol>
    </nav>

    <div class="card mb-4">
        <div class="card-header">
            <strong>Snapshot Details</strong>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">ID</dt>
                <dd class="col-sm-10"><code>@_selectedSnapshot.Id</code></dd>

                <dt class="col-sm-2">Tenant ID</dt>
                <dd class="col-sm-10">@_selectedSnapshot.TenantId</dd>

                <dt class="col-sm-2">Workload</dt>
                <dd class="col-sm-10"><span class="badge bg-secondary">@_selectedSnapshot.Workload</span></dd>

                @if (!string.IsNullOrEmpty(_selectedSnapshot.UtcmResourceType))
                {
                    <dt class="col-sm-2">Resource Type</dt>
                    <dd class="col-sm-10">@GetFriendlyTypeName(_selectedSnapshot.UtcmResourceType)</dd>
                }

                @if (!string.IsNullOrEmpty(_selectedSnapshot.ResourceDisplayName))
                {
                    <dt class="col-sm-2">Resource Name</dt>
                    <dd class="col-sm-10"><strong>@CleanDisplayName(_selectedSnapshot.ResourceDisplayName, _selectedSnapshot.UtcmResourceType)</strong></dd>
                }

                <dt class="col-sm-2">Created At</dt>
                <dd class="col-sm-10">@_selectedSnapshot.CreatedAt.ToString("G") (UTC)</dd>

                <dt class="col-sm-2">Source</dt>
                <dd class="col-sm-10">@_selectedSnapshot.Source</dd>

                <dt class="col-sm-2">Status</dt>
                <dd class="col-sm-10">
                    @if (_selectedSnapshot.HasChangesFromPrevious == true)
                    {
                        <span class="badge bg-warning text-dark">Changed</span>
                    }
                    else if (_selectedSnapshot.HasChangesFromPrevious == false)
                    {
                        <span class="text-muted">No changes from previous</span>
                    }
                    else
                    {
                        <span class="badge bg-info">Initial snapshot</span>
                    }
                </dd>

                @if (!string.IsNullOrEmpty(_selectedSnapshot.UtcmJobId))
                {
                    <dt class="col-sm-2">UTCM Job ID</dt>
                    <dd class="col-sm-10"><code>@_selectedSnapshot.UtcmJobId</code></dd>
                }

                @if (!string.IsNullOrEmpty(_selectedSnapshot.Description))
                {
                    <dt class="col-sm-2">Description</dt>
                    <dd class="col-sm-10">@_selectedSnapshot.Description</dd>
                }
            </dl>

            @if (_selectedSnapshot.ResourceId.HasValue)
            {
                <a href="resources/@_selectedSnapshot.ResourceId" class="btn btn-outline-secondary">View Resource History</a>
            }
        </div>
    </div>

    <h3>Configuration</h3>
    <pre class="bg-light p-3" style="max-height: 500px; overflow: auto;">@FormatJson(_selectedSnapshot.ConfigurationJson)</pre>
}
else
{
    <div class="row mb-3">
        <div class="col-md-3">
            <label for="workloadFilter" class="form-label">Workload</label>
            <select class="form-select" id="workloadFilter" @onchange="OnWorkloadFilterChanged">
                <option value="">All Workloads</option>
                @foreach (var workload in _workloads)
                {
                    <option value="@workload" selected="@(_selectedWorkload == workload)">@workload</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label for="typeFilter" class="form-label">Resource Type</label>
            <select class="form-select" id="typeFilter" @onchange="OnTypeFilterChanged" disabled="@string.IsNullOrEmpty(_selectedWorkload)">
                <option value="">All Types</option>
                @foreach (var type in _resourceTypes)
                {
                    <option value="@type" selected="@(_selectedType == type)">@GetFriendlyTypeName(type)</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="statusFilter" class="form-label">Status</label>
            <select class="form-select" id="statusFilter" @onchange="OnStatusFilterChanged">
                <option value="" selected="@(_statusFilter == "")">All</option>
                <option value="changed" selected="@(_statusFilter == "changed")">Changed only</option>
                <option value="initial" selected="@(_statusFilter == "initial")">Initial only</option>
            </select>
        </div>
    </div>

    @if (_snapshots.Count == 0)
    {
        <div class="alert alert-info">
            No snapshots found.
            @if (!string.IsNullOrEmpty(_selectedWorkload) || !string.IsNullOrEmpty(_selectedType))
            {
                <text> Try adjusting your filters.</text>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Showing @_snapshots.Count snapshots</p>

        <QuickGrid Items="@_snapshots.AsQueryable()" Class="table table-striped table-hover">
            <TemplateColumn Title="ID">
                <a href="snapshots/@context.Id"><code>@context.Id.ToString()[..8]</code></a>
            </TemplateColumn>
            <TemplateColumn Title="Workload" SortBy="@(GridSort<Snapshot>.ByAscending(s => s.Workload))">
                <span class="badge bg-secondary">@context.Workload</span>
            </TemplateColumn>
            <TemplateColumn Title="Type" SortBy="@(GridSort<Snapshot>.ByAscending(s => s.UtcmResourceType))">
                <small>@GetFriendlyTypeName(context.UtcmResourceType ?? "")</small>
            </TemplateColumn>
            <TemplateColumn Title="Resource" SortBy="@(GridSort<Snapshot>.ByAscending(s => CleanDisplayName(s.ResourceDisplayName ?? "", s.UtcmResourceType)))">
                @if (!string.IsNullOrEmpty(context.ResourceDisplayName))
                {
                    <strong>@CleanDisplayName(context.ResourceDisplayName, context.UtcmResourceType)</strong>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Status" SortBy="@(GridSort<Snapshot>.ByDescending(s => s.HasChangesFromPrevious))">
                @if (context.HasChangesFromPrevious == true)
                {
                    <span class="badge bg-warning text-dark">Changed</span>
                }
                else if (context.HasChangesFromPrevious == false)
                {
                    <span class="text-muted small">-</span>
                }
                else
                {
                    <span class="badge bg-info">Initial</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Created At" SortBy="@(GridSort<Snapshot>.ByDescending(s => s.CreatedAt))">
                <small>@context.CreatedAt.ToString("g")</small>
            </TemplateColumn>
            <TemplateColumn Title="Actions">
                <a href="snapshots/@context.Id" class="btn btn-sm btn-outline-primary">View</a>
                @if (context.ResourceId.HasValue)
                {
                    <a href="resources/@context.ResourceId" class="btn btn-sm btn-outline-secondary">History</a>
                }
            </TemplateColumn>
        </QuickGrid>
    }
}

@code {
    [Parameter]
    public string? SnapshotId { get; set; }

    private bool _loading = true;
    private List<Snapshot> _snapshots = new();
    private List<string> _workloads = new();
    private List<string> _resourceTypes = new();
    private Snapshot? _selectedSnapshot;
    private string _selectedWorkload = "";
    private string _selectedType = "";
    private string _statusFilter = "";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        await LoadData();
        _loading = false;
    }

    private async Task LoadData()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();

        if (!string.IsNullOrEmpty(SnapshotId) && Guid.TryParse(SnapshotId, out var id))
        {
            _selectedSnapshot = await context.Snapshots.FirstOrDefaultAsync(s => s.Id == id);
        }
        else
        {
            _selectedSnapshot = null;

            // Load workloads
            _workloads = await context.Snapshots
                .Select(s => s.Workload)
                .Distinct()
                .OrderBy(w => w)
                .ToListAsync();

            // Load resource types for selected workload
            if (!string.IsNullOrEmpty(_selectedWorkload))
            {
                _resourceTypes = await context.Snapshots
                    .Where(s => s.Workload == _selectedWorkload && s.UtcmResourceType != null)
                    .Select(s => s.UtcmResourceType!)
                    .Distinct()
                    .OrderBy(t => t)
                    .ToListAsync();
            }
            else
            {
                _resourceTypes = new();
            }

            // Build query
            var query = context.Snapshots.AsQueryable();

            if (!string.IsNullOrEmpty(_selectedWorkload))
                query = query.Where(s => s.Workload == _selectedWorkload);

            if (!string.IsNullOrEmpty(_selectedType))
                query = query.Where(s => s.UtcmResourceType == _selectedType);

            if (_statusFilter == "changed")
                query = query.Where(s => s.HasChangesFromPrevious == true);
            else if (_statusFilter == "initial")
                query = query.Where(s => s.HasChangesFromPrevious == null);

            _snapshots = await query
                .OrderByDescending(s => s.CreatedAt)
                .Take(100)
                .ToListAsync();
        }
    }

    private async Task OnWorkloadFilterChanged(ChangeEventArgs e)
    {
        _selectedWorkload = e.Value?.ToString() ?? "";
        _selectedType = ""; // Reset type filter when workload changes
        await LoadData();
    }

    private async Task OnTypeFilterChanged(ChangeEventArgs e)
    {
        _selectedType = e.Value?.ToString() ?? "";
        await LoadData();
    }

    private async Task OnStatusFilterChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "";
        await LoadData();
    }

    private static string FormatJson(string json)
    {
        try
        {
            var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch
        {
            return json;
        }
    }

    /// <summary>
    /// Converts resource type to friendly name.
    /// e.g., "microsoft.entra.conditionalAccessPolicy" -> "Conditional Access Policy"
    /// </summary>
    private static string GetFriendlyTypeName(string resourceType)
    {
        if (string.IsNullOrEmpty(resourceType)) return "-";

        // Get last part after the last dot
        var lastPart = resourceType.Split('.').LastOrDefault() ?? resourceType;

        // Convert camelCase to Title Case with spaces
        var result = System.Text.RegularExpressions.Regex.Replace(lastPart, "(\\B[A-Z])", " $1");
        return char.ToUpper(result[0]) + result[1..];
    }

    /// <summary>
    /// Cleans up display name by removing the type prefix.
    /// UTCM display names are formatted as "{TypePrefix}-{ActualName}"
    /// e.g., "AADConditionalAccessPolicy-Require MFA" -> "Require MFA"
    /// </summary>
    private static string CleanDisplayName(string displayName, string? resourceType)
    {
        if (string.IsNullOrEmpty(displayName)) return "-";

        // UTCM format is always "{TypePrefix}-{ActualName}"
        // Just take everything after the first dash
        var dashIndex = displayName.IndexOf('-');
        if (dashIndex > 0 && dashIndex < displayName.Length - 1)
        {
            return displayName[(dashIndex + 1)..];
        }

        return displayName;
    }
}
