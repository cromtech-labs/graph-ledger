@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<GraphLedgerDbContext> ContextFactory

<PageTitle>Dashboard - GraphLedger</PageTitle>

<h1>Dashboard</h1>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Total Snapshots</h5>
                    <p class="card-text display-4">@_totalSnapshots</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Resources Tracked</h5>
                    <p class="card-text display-4">@_totalResources</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Changed This Week</h5>
                    <p class="card-text display-4">@_changedThisWeek</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Workloads</h5>
                    <p class="card-text display-4">@_workloadCount</p>
                </div>
            </div>
        </div>
    </div>

    @if (_recentChanges.Count > 0)
    {
        <h2>Recent Changes <a href="resources?changed-since=7" class="btn btn-sm btn-outline-secondary float-end">View All</a></h2>
        <div class="list-group mb-4">
            @foreach (var resource in _recentChanges)
            {
                <a href="resources/@resource.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@resource.DisplayName</strong>
                        <br/>
                        <small class="text-muted">
                            <span class="badge bg-secondary">@resource.Workload</span>
                            @GetShortTypeName(resource.ResourceType)
                        </small>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-warning text-dark">Changed</span>
                        <br/>
                        <small class="text-muted">@FormatTimeAgo(resource.LastChangedAt!.Value)</small>
                    </div>
                </a>
            }
        </div>
    }

    <h2>Recent Snapshots</h2>
    @if (_recentSnapshots.Count == 0)
    {
        <p>No snapshots found. Use the CLI to take your first snapshot.</p>
        <pre>graphledger snapshot take</pre>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Resource</th>
                    <th>Workload</th>
                    <th>Created At</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var snapshot in _recentSnapshots)
                {
                    <tr>
                        <td><code>@snapshot.Id.ToString()[..8]</code></td>
                        <td>
                            @if (!string.IsNullOrEmpty(snapshot.ResourceDisplayName))
                            {
                                <strong>@TruncateString(snapshot.ResourceDisplayName, 30)</strong>
                                <br/><small class="text-muted">@GetShortTypeName(snapshot.UtcmResourceType ?? "")</small>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td><span class="badge bg-secondary">@snapshot.Workload</span></td>
                        <td>@snapshot.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
                        <td>
                            @if (snapshot.HasChangesFromPrevious == true)
                            {
                                <span class="badge bg-warning text-dark">Changed</span>
                            }
                            else if (snapshot.HasChangesFromPrevious == false)
                            {
                                <span class="text-muted">No changes</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Initial</span>
                            }
                        </td>
                        <td>
                            <a href="snapshots/@snapshot.Id" class="btn btn-sm btn-outline-primary">View</a>
                            @if (snapshot.ResourceId.HasValue)
                            {
                                <a href="resources/@snapshot.ResourceId" class="btn btn-sm btn-outline-secondary">History</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private bool _loading = true;
    private int _totalSnapshots;
    private int _totalResources;
    private int _changedThisWeek;
    private int _workloadCount;
    private List<Snapshot> _recentSnapshots = new();
    private List<Resource> _recentChanges = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();

        _totalSnapshots = await context.Snapshots.CountAsync();
        _totalResources = await context.Resources.CountAsync();
        _workloadCount = await context.Resources.Select(r => r.Workload).Distinct().CountAsync();

        var weekAgo = DateTime.UtcNow.AddDays(-7);
        _changedThisWeek = await context.Resources
            .CountAsync(r => r.LastChangedAt >= weekAgo);

        _recentChanges = await context.Resources
            .Where(r => r.LastChangedAt >= weekAgo)
            .OrderByDescending(r => r.LastChangedAt)
            .Take(5)
            .ToListAsync();

        _recentSnapshots = await context.Snapshots
            .OrderByDescending(s => s.CreatedAt)
            .Take(10)
            .ToListAsync();

        _loading = false;
    }

    private static string TruncateString(string value, int maxLength)
    {
        if (string.IsNullOrEmpty(value)) return "-";
        return value.Length <= maxLength ? value : value[..(maxLength - 3)] + "...";
    }

    private static string GetShortTypeName(string resourceType)
    {
        if (string.IsNullOrEmpty(resourceType)) return "";
        var parts = resourceType.Split('.');
        return parts.Length > 0 ? parts[^1] : resourceType;
    }

    private static string FormatTimeAgo(DateTime dateTime)
    {
        var elapsed = DateTime.UtcNow - dateTime;

        if (elapsed.TotalMinutes < 60)
            return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalHours < 24)
            return $"{(int)elapsed.TotalHours}h ago";
        if (elapsed.TotalDays < 7)
            return $"{(int)elapsed.TotalDays}d ago";

        return dateTime.ToString("MMM dd");
    }
}
