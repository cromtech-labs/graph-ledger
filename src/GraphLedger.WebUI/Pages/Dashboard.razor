@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<GraphLedgerDbContext> ContextFactory
@using System.Globalization

<PageTitle>Dashboard - GraphLedger</PageTitle>

<div class="alert alert-info">
    <strong>Debug:</strong> Culture: @CultureInfo.CurrentCulture.Name | Date: @DateTime.Now.ToString("D")
</div>

<h1>Dashboard</h1>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Total Snapshots</h5>
                    <p class="card-text display-4">@_totalSnapshots</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Resources Tracked</h5>
                    <p class="card-text display-4">@_totalResources</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Changed This Week</h5>
                    <p class="card-text display-4">@_changedThisWeek</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Workloads</h5>
                    <p class="card-text display-4">@_workloadCount</p>
                </div>
            </div>
        </div>
    </div>

    @if (_recentChanges.Count > 0)
    {
        <h2>Recent Changes <a href="resources?changed-since=7" class="btn btn-sm btn-outline-secondary float-end">View All</a></h2>
        <div class="list-group mb-4">
            @foreach (var resource in _recentChanges)
            {
                <a href="resources/@resource.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@CleanDisplayName(resource.DisplayName, resource.ResourceType)</strong>
                        <br/>
                        <small class="text-muted">
                            <span class="badge bg-secondary">@resource.Workload</span>
                            @GetFriendlyTypeName(resource.ResourceType)
                        </small>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-warning text-dark">Changed</span>
                        <br/>
                        <small class="text-muted">@FormatTimeAgo(resource.LastChangedAt!.Value)</small>
                    </div>
                </a>
            }
        </div>
    }

    <h2>Recent Snapshots</h2>
    @if (_recentSnapshots.Count == 0)
    {
        <p>No snapshots found. Use the CLI to take your first snapshot.</p>
        <pre>graphledger snapshot take</pre>
    }
    else
    {
        <QuickGrid Items="@_recentSnapshots.AsQueryable()" Class="table table-striped">
            <TemplateColumn Title="ID">
                <code>@context.Id.ToString()[..8]</code>
            </TemplateColumn>
            <TemplateColumn Title="Workload" SortBy="@(GridSort<Snapshot>.ByAscending(s => s.Workload))">
                <span class="badge bg-secondary">@context.Workload</span>
            </TemplateColumn>
            <TemplateColumn Title="Type" SortBy="@(GridSort<Snapshot>.ByAscending(s => s.UtcmResourceType))">
                <small>@GetFriendlyTypeName(context.UtcmResourceType ?? "")</small>
            </TemplateColumn>
            <TemplateColumn Title="Resource" SortBy="@(GridSort<Snapshot>.ByAscending(s => s.ResourceDisplayName))">
                @if (!string.IsNullOrEmpty(context.ResourceDisplayName))
                {
                    <strong>@CleanDisplayName(context.ResourceDisplayName, context.UtcmResourceType)</strong>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Status" SortBy="@(GridSort<Snapshot>.ByDescending(s => s.HasChangesFromPrevious))">
                @if (context.HasChangesFromPrevious == true)
                {
                    <span class="badge bg-warning text-dark">Changed</span>
                }
                else if (context.HasChangesFromPrevious == false)
                {
                    <span class="text-muted">No changes</span>
                }
                else
                {
                    <span class="badge bg-info">Initial</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="Created At" SortBy="@(GridSort<Snapshot>.ByDescending(s => s.CreatedAt))">
                <small>@context.CreatedAt.ToString("g")</small>
            </TemplateColumn>
            <TemplateColumn Title="Actions">
                <a href="snapshots/@context.Id" class="btn btn-sm btn-outline-primary">View</a>
                @if (context.ResourceId.HasValue)
                {
                    <a href="resources/@context.ResourceId" class="btn btn-sm btn-outline-secondary">History</a>
                }
            </TemplateColumn>
        </QuickGrid>
    }
}

@code {
    private bool _loading = true;
    private int _totalSnapshots;
    private int _totalResources;
    private int _changedThisWeek;
    private int _workloadCount;
    private List<Snapshot> _recentSnapshots = new();
    private List<Resource> _recentChanges = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();

        _totalSnapshots = await context.Snapshots.CountAsync();
        _totalResources = await context.Resources.CountAsync();
        _workloadCount = await context.Resources.Select(r => r.Workload).Distinct().CountAsync();

        var weekAgo = DateTime.UtcNow.AddDays(-7);
        _changedThisWeek = await context.Resources
            .CountAsync(r => r.LastChangedAt >= weekAgo);

        _recentChanges = await context.Resources
            .Where(r => r.LastChangedAt >= weekAgo)
            .OrderByDescending(r => r.LastChangedAt)
            .Take(5)
            .ToListAsync();

        _recentSnapshots = await context.Snapshots
            .OrderByDescending(s => s.CreatedAt)
            .Take(10)
            .ToListAsync();

        _loading = false;
    }

    private static string TruncateString(string value, int maxLength)
    {
        if (string.IsNullOrEmpty(value)) return "-";
        return value.Length <= maxLength ? value : value[..(maxLength - 3)] + "...";
    }

    private static string GetShortTypeName(string resourceType)
    {
        if (string.IsNullOrEmpty(resourceType)) return "";
        var parts = resourceType.Split('.');
        return parts.Length > 0 ? parts[^1] : resourceType;
    }

    private static string GetFriendlyTypeName(string resourceType)
    {
        if (string.IsNullOrEmpty(resourceType)) return "";
        var lastPart = resourceType.Split('.').LastOrDefault() ?? resourceType;
        var result = System.Text.RegularExpressions.Regex.Replace(lastPart, "(\\B[A-Z])", " $1");
        return char.ToUpper(result[0]) + result[1..];
    }

    private static string CleanDisplayName(string displayName, string? resourceType)
    {
        if (string.IsNullOrEmpty(displayName)) return "-";

        var dashIndex = displayName.IndexOf('-');
        if (dashIndex > 0 && dashIndex < displayName.Length - 1)
        {
            return displayName[(dashIndex + 1)..];
        }

        return displayName;
    }

    private static string FormatTimeAgo(DateTime dateTime)
    {
        var elapsed = DateTime.UtcNow - dateTime;

        if (elapsed.TotalMinutes < 60)
            return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalHours < 24)
            return $"{(int)elapsed.TotalHours}h ago";
        if (elapsed.TotalDays < 7)
            return $"{(int)elapsed.TotalDays}d ago";

        return dateTime.ToString("d");
    }
}
